{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.0.0",
  "default_locale": "ja",
  "description": "__MSG_appDesc__",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["readingList", "storage", "sidePanel", "contextMenus", "tabs", "favicon"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "__MSG_appName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "__MSG_cmdOpenAction__"
    },
    "open-full": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "__MSG_cmdOpenFull__"
    },
    "add-current-tab": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "__MSG_cmdAddCurrentTab__"
    }
  }
}
